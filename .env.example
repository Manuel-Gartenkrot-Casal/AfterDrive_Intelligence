# Proveedor de IA: "local" (LM Studio), "nvidia" (NVIDIA Build), "openrouter" o "paga"
AI_PROVIDER=openrouter

# Proveedor SOLO para embeddings. Vacío = usa el mismo que AI_PROVIDER.
# "paga" = API paga (requiere PAGA_API_KEY, PAGA_BASE_URL y PAGA_EMB_MODEL).
# OpenRouter no tiene endpoint de embeddings: si AI_PROVIDER=openrouter hay que
# poner "nvidia" (o "local") acá, o los embeddings no se van a poder calcular.
EMBEDDINGS_PROVIDER=nvidia

# LM Studio (solo si AI_PROVIDER=local)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=mistral-7b-instruct-v0.3
LMSTUDIO_EMB_MODEL=text-embedding-nomic-embed-text-v1.5

# NVIDIA Build (solo si AI_PROVIDER=nvidia)
NVIDIA_API_KEY=tu-api-key-aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b
NVIDIA_EMB_MODEL=nvidia/nemotron-3-embed-1b

# OpenRouter (solo si AI_PROVIDER=openrouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY=tu-api-key-aqui
OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct:free

# API paga (solo si AI_PROVIDER=paga). Las tres primeras son obligatorias; sin
# ellas no se activa.
#   Bedrock (AWS): PAGA_API=converse, PAGA_BASE_URL=https://bedrock-runtime.<región>.amazonaws.com,
#   PAGA_API_KEY = API key de Bedrock (de largo plazo) y cada modelo = ARN del
#   application inference profile (arn:aws:bedrock:<región>:<cuenta>:application-inference-profile/...).
#   Otra API compatible con OpenAI: PAGA_API vacío y PAGA_BASE_URL con /v1.
PAGA_API=
PAGA_API_KEY=
PAGA_BASE_URL=
PAGA_MODEL=
PAGA_FALLBACK_MODEL=
# Un modelo por tarea (opcionales; vacías = PAGA_MODEL). Con Bedrock:
#   clasificación GPT-6 Luna, evaluación GPT-5.6 Luna, redacción Kimi K3.
PAGA_MODEL_CLASIFICACION=
PAGA_MODEL_EVALUACION=
PAGA_MODEL_REDACCION=
# Tope de gasto mensual en USD (por defecto 40, con margen sobre el límite real).
# Alcanzado, el chat sigue por NVIDIA hasta el mes siguiente. Cada llamada queda
# en la colección consumo_ia de Mongo con sus tokens y su costo.
PAGA_TOPE_MENSUAL_USD=40
# Precio por 1M de tokens "entrada/salida" del modelo de cada variable (el
# proveedor solo informa tokens). Vacías = precios de Bedrock ruta US para el
# reparto de arriba: clasificación 0.11/0.55, evaluación 0.22/1.32, redacción
# 3.30/16.50. Si cambiás qué perfil va en cada tarea, cambiá también su precio.
# PAGA_MODEL y PAGA_FALLBACK_MODEL sin precio se cobran al más alto (3.30/16.50).
PAGA_PRECIO_CLASIFICACION=
PAGA_PRECIO_EVALUACION=
PAGA_PRECIO_REDACCION=
PAGA_PRECIO_GENERAL=
PAGA_PRECIO_FALLBACK=
PAGA_PRECIO_EMBEDDINGS=
# Segundos de espera de una llamada Converse (sin streaming: la respuesta llega entera).
CONVERSE_TIMEOUT=600
# Solo para APIs compatibles con OpenAI (Converse no los usa):
#   OpenAI usa max_completion_tokens; otro proveedor puede pedir max_tokens.
PAGA_CAMPO_MAX_TOKENS=max_completion_tokens
#   0 = no mandar temperature (algunos modelos que razonan la rechazan).
PAGA_TEMPERATURA=1
# Embeddings (RAG: elección de noticias para cada nota) por la API paga, solo con
# una API compatible con OpenAI (Converse no hace embeddings: con Bedrock quedan en
# NVIDIA). Para usarlos: EMBEDDINGS_PROVIDER=paga + este modelo.
# Sin key o sin modelo, los embeddings siguen por NVIDIA (o local).
# Elegir "API paga" en el dashboard NO cambia los embeddings: hace falta
# EMBEDDINGS_PROVIDER=paga. Al cambiar de modelo, re-vectorizar lo guardado (si
# no, el RAG descarta los vectores del modelo anterior y elige solo por recencia):
#   python -m afterdrive.ingesta.embeddings
PAGA_EMB_MODEL=

# Jev AI (TypeSafe - clasificador de relevancia)
TYPESAFE_API_KEY=tu-api-key-aqui
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.5

# Corridas programadas en GitHub Actions (opcional). Con "github", este
# servidor deja de programar el scraping y la nota automática: las corre el
# workflow .github/workflows/corridas.yml. Ver docs/08-despliegue.md.
CORRIDAS_EXTERNAS=

# Atlas Vector Search (opcional): nombre del índice vectorial sobre
# articulos.embedding. Con él, las noticias de contexto se eligen entre las
# más parecidas de toda la base y no solo entre las 200 más recientes.
# Ver docs/08-despliegue.md para crear el índice.
ATLAS_VECTOR_INDEX=

# HubSpot (opcional): publicar notas aprobadas en el blog.
# Token de una app privada con el scope "content"
# (Configuración > Integraciones > Apps privadas) y el id del blog (contentGroupId).
HUBSPOT_TOKEN=
HUBSPOT_BLOG_ID=
# Opcional: id del autor del blog (blogAuthorId)
HUBSPOT_AUTOR_ID=
# Opcional: imagen destacada (https) para las notas que no tienen una propia
HUBSPOT_IMAGEN_DEFAULT=
# Opcional: idioma de las etiquetas que se crean en el blog (es por defecto)
HUBSPOT_IDIOMA=es

# MongoDB Atlas (obligatorio)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=TuApp

# URL pública del servicio (Render la inyecta automáticamente como
# RENDER_EXTERNAL_URL). Se usa para el keep-alive anti-spin-down: el ping
# debe ir a la URL pública, no a localhost, o Render no cuenta la actividad.
RENDER_EXTERNAL_URL=https://tuapp.onrender.com

# ── Acceso al dashboard (obligatorias: si falta alguna de las tres primeras, nadie entra) ──
# Usuario administrador.
ADMIN_USER=admin
# Hash de la contraseña (NO la contraseña). Generarlo con:
#   python -c "from getpass import getpass; from werkzeug.security import generate_password_hash as g; print(g(getpass('Contraseña: ')))"
# El hash trae signos "$": en un archivo .env va SIEMPRE entre comillas simples,
# o docker compose lo interpreta como variables y lo rompe. En el panel de
# Render se pega tal cual, sin comillas.
ADMIN_PASSWORD_HASH='scrypt:32768:8:1$pegar$el-hash-aqui'
# Firma la cookie de sesión. Cambiarla cierra todas las sesiones. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Va vacía a propósito: sin un valor propio el login queda cerrado. Un valor de
# ejemplo acá sería una clave publicada en el repo.
SECRET_KEY=
# Token de las corridas automáticas (cron de Render o monitor externo). Se envía
# como header "Authorization: Bearer <token>" y solo vale para
# POST /api/run-automation y POST /api/run-generacion. Mismo comando que SECRET_KEY
# (otro valor). Vacía: ningún token habilita las corridas por HTTP.
CRON_TOKEN=
