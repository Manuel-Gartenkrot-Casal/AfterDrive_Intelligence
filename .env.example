# Proveedor de IA: "local" (LM Studio), "nvidia" (NVIDIA Build) u "openrouter"
AI_PROVIDER=openrouter

# Proveedor SOLO para embeddings. Vacío = usa el mismo que AI_PROVIDER.
# OpenRouter no tiene endpoint de embeddings: si AI_PROVIDER=openrouter hay que
# poner "nvidia" (o "local") acá, o los embeddings no se van a poder calcular.
EMBEDDINGS_PROVIDER=nvidia

# LM Studio (solo si AI_PROVIDER=local)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=mistral-7b-instruct-v0.3
LMSTUDIO_EMB_MODEL=text-embedding-nomic-embed-text-v1.5

# NVIDIA Build (solo si AI_PROVIDER=nvidia)
NVIDIA_API_KEY=tu-api-key-aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b
NVIDIA_EMB_MODEL=nvidia/nemotron-3-embed-1b

# OpenRouter (solo si AI_PROVIDER=openrouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY=tu-api-key-aqui
OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct:free

# Jev AI (TypeSafe - clasificador de relevancia)
TYPESAFE_API_KEY=tu-api-key-aqui
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.5

# MongoDB Atlas (obligatorio)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=TuApp

# URL pública del servicio (Render la inyecta automáticamente como
# RENDER_EXTERNAL_URL). Se usa para el keep-alive anti-spin-down: el ping
# debe ir a la URL pública, no a localhost, o Render no cuenta la actividad.
RENDER_EXTERNAL_URL=https://tuapp.onrender.com

# ── Acceso al dashboard (obligatorias: si falta alguna de las tres primeras, nadie entra) ──
# Usuario administrador.
ADMIN_USER=admin
# Hash de la contraseña (NO la contraseña). Generarlo con:
#   python -c "from getpass import getpass; from werkzeug.security import generate_password_hash as g; print(g(getpass('Contraseña: ')))"
# El hash trae signos "$": en un archivo .env va SIEMPRE entre comillas simples,
# o docker compose lo interpreta como variables y lo rompe. En el panel de
# Render se pega tal cual, sin comillas.
ADMIN_PASSWORD_HASH='scrypt:32768:8:1$pegar$el-hash-aqui'
# Firma la cookie de sesión. Cambiarla cierra todas las sesiones. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Va vacía a propósito: sin un valor propio el login queda cerrado. Un valor de
# ejemplo acá sería una clave publicada en el repo.
SECRET_KEY=
# Token de las corridas automáticas (cron de Render o monitor externo). Se envía
# como header "Authorization: Bearer <token>" y solo vale para
# POST /api/run-automation y POST /api/run-generacion. Mismo comando que SECRET_KEY
# (otro valor). Vacía: ningún token habilita las corridas por HTTP.
CRON_TOKEN=
